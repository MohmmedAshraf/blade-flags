{
  "name": "@blade-flags/react",
  "version": "0.3.0",
  "description": "React flag components powered by @blade-flags/core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohmmedAshraf/blade-flags.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./flag": {
      "types": "./dist/flag.d.ts",
      "import": "./dist/flag.js",
      "require": "./dist/flag.cjs"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "require": "./dist/auto.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@blade-flags/core": ">=0.1.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@blade-flags/core": "workspace:*",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.2.0"
  }
}
